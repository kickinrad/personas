{
  "description": "Activation rules for persona-dashboard skills",
  "rules": {
    "install": {
      "kind": "skill",
      "type": "process",
      "enforcement": "must",
      "priority": "medium",
      "activationHint": "Skill('persona-dashboard:install')",
      "promptTriggers": {
        "keywords": ["persona dashboard", "persona viewer", "visual persona status"],
        "intentPatterns": ["(add|set up|create|build|install).*?persona dashboard", "persona dashboard.*?(for|to)", "browse.*?(persona profile|persona memory)"]
      },
      "fileTriggers": {
        "pathPatterns": [],
        "contentPatterns": []
      }
    }
  }
}
