#!/usr/bin/env bash
# Reconcile gitignored user/ data for all personas in configured peer roots.

set -uo pipefail

script_dir=$(dirname "$(readlink -f "$0")")
script_name=$(basename "$0")
sibling_name="${script_name/sync-user-all/sync-user-persona}"
sync_one="$script_dir/$sibling_name"
[ -x "$sync_one" ] || {
  printf 'sync-user-all: sibling executable unavailable\n' >&2
  exit 1
}

primary_root="${PERSONAS_MESH_ROOT:-}"
peer_root="${PERSONAS_MESH_PEER_ROOT:-}"
[ -n "$primary_root" ] && [ -n "$peer_root" ] || {
  printf 'sync-user-all: PERSONAS_MESH_ROOT and PERSONAS_MESH_PEER_ROOT are required\n' >&2
  exit 1
}

verbose_flag=()
for arg in "$@"; do
  case "$arg" in
    --verbose|-v) verbose_flag=(--verbose) ;;
    *) printf 'sync-user-all: unknown argument: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

failed=0
for dir in "$primary_root"/*/; do
  [ -d "$dir" ] || continue
  [ -f "$dir/.persona-cwd" ] && continue
  persona=$(basename "$dir")
  "$sync_one" "${verbose_flag[@]}" "$persona" || failed=1
done

[ "$failed" = "0" ]
