#!/usr/bin/env bash
# Render generic 1Password templates and atomically deep-merge JSON output.
#
# Usage: render-config <template-json> <output-json> [profile-json]
#
# Secret placeholders use 1Password's native inject syntax:
#   {{ op://<vault>/<item>/<field> }}
#
# The optional profile is a nonsecret JSON object. Merge precedence is:
# existing output < injected template < profile.

set -euo pipefail
set +x
umask 077

die() { printf 'render-config: %s\n' "$*" >&2; exit 1; }

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || \
  die "usage: render-config <template-json> <output-json> [profile-json]"

template="$1"
output="$2"
profile="${3:-}"

[ -f "$template" ] || die "template not found: $template"
[ -z "$profile" ] || [ -f "$profile" ] || die "profile not found: $profile"

op_bin="${OP_BIN:-$(command -v op || true)}"
[ -n "$op_bin" ] || die "op CLI unavailable"

token="${OP_SERVICE_ACCOUNT_TOKEN:-}"
token_file="${OP_SERVICE_ACCOUNT_TOKEN_FILE:-${HOME}/.config/op/service-account.token}"
if [ -z "$token" ]; then
  [ -r "$token_file" ] || die "1Password service-account token unavailable"
  token=$(<"$token_file")
fi

output_dir=$(dirname -- "$output")
mkdir -p "$output_dir"
injected=$(mktemp "${output_dir}/.render-config.injected.XXXXXX")
merged=$(mktemp "${output_dir}/.render-config.merged.XXXXXX")
cleanup() {
  rm -f -- "$injected" "$merged"
}
trap cleanup EXIT
chmod 0600 "$injected" "$merged"

# `op inject` receives only nonsecret paths in argv. Resolved values flow from
# the op process directly into a restrictive file and never through a shell
# substitution, command string, logger, or child-process argument.
if ! OP_SERVICE_ACCOUNT_TOKEN="$token" \
  "$op_bin" inject --in-file "$template" --out-file "$injected" \
  >/dev/null 2>&1; then
  die "1Password template injection failed"
fi

jq -e . "$injected" >/dev/null 2>&1 || die "injected template is not valid JSON"
[ -z "$profile" ] || jq -e . "$profile" >/dev/null 2>&1 || \
  die "profile is not valid JSON"

inputs=()
if [ -f "$output" ]; then
  jq -e . "$output" >/dev/null 2>&1 || die "existing output is not valid JSON"
  inputs+=("$output")
fi
inputs+=("$injected")
[ -z "$profile" ] || inputs+=("$profile")

jq -s 'reduce .[] as $item ({}; . * $item)' "${inputs[@]}" > "$merged" 2>/dev/null ||
  die "JSON deep merge failed"
chmod 0600 "$merged"
mv -f -- "$merged" "$output"
trap - EXIT
rm -f -- "$injected"
