#!/usr/bin/env bash
# Push every configured bare repository to an asynchronous mirror remote.

set -uo pipefail

hub_root="${PERSONAS_MESH_HUB_ROOT:-}"
remote="${PERSONAS_MESH_MIRROR_REMOTE:-github}"
[ -n "$hub_root" ] || {
  printf 'mirror-all: PERSONAS_MESH_HUB_ROOT is not configured\n' >&2
  exit 1
}
[ -d "$hub_root" ] || {
  printf 'mirror-all: hub root does not exist: %s\n' "$hub_root" >&2
  exit 1
}

failed=0
for repo in "$hub_root"/*.git; do
  [ -d "$repo" ] || continue
  if ! git -C "$repo" push --mirror "$remote"; then
    printf 'mirror-all: mirror failed: %s\n' "$(basename "$repo")" >&2
    failed=1
  fi
done

exit "$failed"
