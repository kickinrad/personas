#!/usr/bin/env bash
# Reconcile one persona's gitignored user/ directory between configured peers.
#
# Usage: sync-user-persona <persona-name> [--verbose]
# Requires PERSONAS_MESH_ROOT and PERSONAS_MESH_PEER_ROOT.
# Two `rsync -a --update` passes implement newer-mtime-wins without deletes.

set -euo pipefail

VERBOSE=0
persona=""
for arg in "$@"; do
  case "$arg" in
    --verbose|-v) VERBOSE=1 ;;
    -*) printf 'sync-user-persona: unknown flag: %s\n' "$arg" >&2; exit 1 ;;
    *) persona="$arg" ;;
  esac
done

[ -n "$persona" ] || {
  printf 'usage: sync-user-persona <persona> [--verbose]\n' >&2
  exit 1
}
[[ "$persona" =~ ^[a-z][a-z0-9-]*$ ]] || {
  printf 'sync-user-persona: invalid persona name\n' >&2
  exit 1
}

primary_root="${PERSONAS_MESH_ROOT:-}"
peer_root="${PERSONAS_MESH_PEER_ROOT:-}"
[ -n "$primary_root" ] && [ -n "$peer_root" ] || {
  printf 'sync-user-persona: PERSONAS_MESH_ROOT and PERSONAS_MESH_PEER_ROOT are required\n' >&2
  exit 1
}

primary="${primary_root}/${persona}/user"
peer="${peer_root}/${persona}/user"
[ -d "$primary" ] || exit 0
[ -d "$peer" ] || exit 0

verbose_flag=()
[ "$VERBOSE" = "1" ] && verbose_flag=(-v)
rsync -a --update "${verbose_flag[@]}" "${primary}/" "${peer}/" >&2
rsync -a --update "${verbose_flag[@]}" "${peer}/" "${primary}/" >&2

if [ "$VERBOSE" = "1" ]; then
  printf '  %s: synced\n' "$persona" >&2
fi
