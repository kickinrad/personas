#!/usr/bin/env python3
"""Read-only, deterministic persona framework validation."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path
from typing import Any


REQUIRED_DIRS = (
    "user",
    "user/memory",
    ".claude",
    ".claude/output-styles",
    ".claude/hooks",
)
REQUIRED_FILES = (
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "user/profile.md",
    "user/memory/MEMORY.md",
    "hooks.json",
    ".gitignore",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/hooks/public-repo-guard.sh",
    ".claude-flags",
    ".framework-version",
)
EXPECTED_HOOKS = {
    "PreToolUse",
    "SessionStart",
    "Stop",
    "StopFailure",
    "PreCompact",
    "PostCompact",
}
SECRET_PATTERN = re.compile(
    r"(?:eyJ[A-Za-z0-9_-]{20,}|GOCSPX-[A-Za-z0-9_-]{20,}|"
    r"sk-[A-Za-z0-9]{20,}|BEGIN PRIVATE KEY)"
)


def read_json(path: Path, errors: list[str]) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"{path.name}: invalid JSON ({exc})")
        return None
    if not isinstance(value, dict):
        errors.append(f"{path.name}: JSON root must be an object")
        return None
    return value


def plugin_root(explicit: Path | None) -> Path:
    candidates = [
        explicit,
        Path(os.environ["PERSONA_MANAGER_ROOT"])
        if os.environ.get("PERSONA_MANAGER_ROOT")
        else None,
        Path(os.environ["CLAUDE_PLUGIN_ROOT"])
        if os.environ.get("CLAUDE_PLUGIN_ROOT")
        else None,
        Path(__file__).resolve().parents[1],
    ]
    for candidate in candidates:
        if candidate and (candidate / ".claude-plugin/plugin.json").is_file():
            return candidate.resolve()
    raise RuntimeError("persona-manager source root is unavailable")


def ignored_by_gitignore(root: Path, entry: str) -> bool:
    gitignore = root / ".gitignore"
    if not gitignore.is_file():
        return False
    active = {
        line.strip()
        for line in gitignore.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    }
    return entry in active


def validate(root: Path, manager_root: Path) -> dict[str, Any]:
    errors: list[str] = []
    warnings: list[str] = []
    passes: list[str] = []

    if not root.is_dir():
        return {
            "persona": root.name,
            "path": str(root),
            "status": "FAIL",
            "errors": ["persona directory does not exist"],
            "warnings": [],
            "passes": [],
        }

    for relative in REQUIRED_DIRS:
        if (root / relative).is_dir():
            passes.append(f"{relative}/ exists")
        else:
            errors.append(f"{relative}/ is missing")
    for relative in REQUIRED_FILES:
        if (root / relative).is_file():
            passes.append(f"{relative} exists")
        else:
            errors.append(f"{relative} is missing")

    legacy_self_improve = root / ".claude/skills/self-improve"
    if legacy_self_improve.exists():
        errors.append(
            ".claude/skills/self-improve is a forbidden local duplicate; "
            "persona-manager ships the canonical skill"
        )

    settings = read_json(root / ".claude/settings.json", errors)
    if settings:
        sandbox = settings.get("sandbox", {})
        filesystem = sandbox.get("filesystem", {}) if isinstance(sandbox, dict) else {}
        deny_read = set(filesystem.get("denyRead", [])) if isinstance(filesystem, dict) else set()
        if sandbox.get("enabled") is not True:
            errors.append(".claude/settings.json: sandbox.enabled must be true")
        if sandbox.get("autoAllowBashIfSandboxed") is not True:
            errors.append(
                ".claude/settings.json: sandbox.autoAllowBashIfSandboxed must be true"
            )
        missing_denies = {"~/.aws", "~/.ssh", "~/.gnupg", "../"} - deny_read
        if missing_denies:
            errors.append(
                ".claude/settings.json: missing denyRead entries "
                + ", ".join(sorted(missing_denies))
            )
        plugins = settings.get("enabledPlugins", {})
        if not isinstance(plugins, dict) or plugins.get("persona-manager@personas") is not True:
            errors.append(
                ".claude/settings.json: persona-manager@personas must be enabled"
            )

    local_settings = read_json(root / ".claude/settings.local.json", errors)
    if local_settings:
        memory = local_settings.get("autoMemoryDirectory")
        if not isinstance(memory, str) or not Path(memory).is_absolute():
            errors.append(
                ".claude/settings.local.json: autoMemoryDirectory must be absolute"
            )
        elif Path(memory).resolve() != (root / "user/memory").resolve():
            errors.append(
                ".claude/settings.local.json: autoMemoryDirectory must resolve "
                "to this persona's user/memory"
            )

    hooks = read_json(root / "hooks.json", errors)
    if hooks:
        hook_map = hooks.get("hooks", {})
        if not isinstance(hook_map, dict):
            errors.append("hooks.json: hooks must be an object")
        else:
            missing_hooks = EXPECTED_HOOKS - set(hook_map)
            if missing_hooks:
                errors.append(
                    "hooks.json: missing events " + ", ".join(sorted(missing_hooks))
                )

    flags_path = root / ".claude-flags"
    if flags_path.is_file() and "--setting-sources project,local" not in flags_path.read_text(
        encoding="utf-8"
    ):
        errors.append(".claude-flags: missing --setting-sources project,local")

    for required_ignore in (".mcp.json", ".claude/settings.local.json"):
        if not ignored_by_gitignore(root, required_ignore):
            errors.append(f".gitignore: missing active {required_ignore} rule")

    manifest = read_json(manager_root / ".claude-plugin/plugin.json", errors)
    stamp_path = root / ".framework-version"
    if manifest and stamp_path.is_file():
        current = str(manifest.get("version", ""))
        stamp = stamp_path.read_text(encoding="utf-8").strip()
        if stamp != current:
            warnings.append(f"framework drift: persona {stamp or 'unversioned'}, source {current}")

    for path in root.rglob("*"):
        if not path.is_file() or ".git" in path.parts or path.name == ".mcp.json":
            continue
        if path.suffix.lower() not in {".md", ".json", ".sh", ".yaml", ".yml"}:
            continue
        try:
            content = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        if SECRET_PATTERN.search(content):
            errors.append(f"{path.relative_to(root)}: secret-like value detected")

    status = "FAIL" if errors else ("WARN" if warnings else "PASS")
    return {
        "persona": root.name,
        "path": str(root),
        "frameworkSource": str(manager_root),
        "status": status,
        "errors": errors,
        "warnings": warnings,
        "passes": passes,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("persona", type=Path)
    parser.add_argument("--plugin-root", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    try:
        manager_root = plugin_root(args.plugin_root)
    except RuntimeError as exc:
        print(f"validate-persona: {exc}", file=sys.stderr)
        return 2

    report = validate(args.persona.resolve(), manager_root)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"{report['status']}: {report['persona']} ({report['path']})")
        for issue in report["errors"]:
            print(f"ERROR: {issue}")
        for issue in report["warnings"]:
            print(f"WARN: {issue}")
        if report["status"] == "PASS":
            print(f"{len(report['passes'])} deterministic checks passed")
    return 1 if report["errors"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
