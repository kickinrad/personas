#!/usr/bin/env python3
"""Verify or atomically create sanitized Persona Manager homes."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


PROFILES = {"shared", "claude-local", "codex", "claude-cloud"}
CREATE_PROFILES = {"claude-local", "codex", "claude-cloud"}
NAME_PATTERN = re.compile(r"[a-z][a-z0-9-]{0,63}")
SECRET_PATTERN = re.compile(
    r"(?:eyJ[A-Za-z0-9_-]{20,}|GOCSPX-[A-Za-z0-9_-]{20,}|"
    r"sk-[A-Za-z0-9]{20,}|BEGIN PRIVATE KEY)"
)
SHARED_FILES = ("README.md", "user/profile.md", "user/memory/MEMORY.md", ".gitignore", ".framework-version")
CLAUDE_FILES = (
    "CLAUDE.md",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude-flags",
    "hooks.json",
    ".claude/hooks/public-repo-guard.sh",
)


class PersonaArgumentParser(argparse.ArgumentParser):
    """Keep JSON invocation failures machine-readable as well as operational ones."""

    def error(self, message: str) -> None:
        if "--json" in sys.argv[1:]:
            print(json.dumps({
                "schemaVersion": 1,
                "status": "FAIL",
                "profile": None,
                "path": None,
                "checks": {},
                "errors": [f"invocation: {message}"],
                "warnings": [],
                "passes": [],
            }, indent=2, sort_keys=True))
            raise SystemExit(2)
        super().error(message)


def add(checks: dict[str, dict[str, list[str]]], section: str, *, passed: str | None = None, error: str | None = None, warning: str | None = None) -> None:
    bucket = checks.setdefault(section, {"passes": [], "warnings": [], "errors": []})
    if passed:
        bucket["passes"].append(passed)
    if warning:
        bucket["warnings"].append(warning)
    if error:
        bucket["errors"].append(error)


def plugin_root() -> Path:
    root = Path(__file__).resolve().parents[1]
    if not (root / ".claude-plugin/plugin.json").is_file():
        raise RuntimeError("Persona Manager plugin root is unavailable")
    return root


def version(root: Path) -> str:
    try:
        return str(json.loads((root / ".claude-plugin/plugin.json").read_text(encoding="utf-8"))["version"])
    except (OSError, KeyError, json.JSONDecodeError, TypeError) as exc:
        raise RuntimeError(f"Persona Manager manifest is unreadable: {exc}") from exc


def check_shared(home: Path, checks: dict[str, dict[str, list[str]]], source_version: str, *, require_private_state: bool = True) -> None:
    required_files = SHARED_FILES if require_private_state else ("README.md", ".gitignore", ".framework-version")
    for relative in required_files:
        path = home / relative
        if path.is_file():
            add(checks, "shared", passed=f"{relative} exists")
        else:
            add(checks, "shared", error=f"shared: {relative} is missing")

    gitignore = home / ".gitignore"
    if gitignore.is_file():
        active = {
            line.strip()
            for line in gitignore.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
        for ignored in (".mcp.json", ".claude/settings.local.json"):
            if ignored in active:
                add(checks, "shared", passed=f".gitignore ignores {ignored}")
            else:
                add(checks, "shared", error=f"shared: .gitignore is missing active {ignored} rule")

    stamp = home / ".framework-version"
    if stamp.is_file():
        current = stamp.read_text(encoding="utf-8").strip()
        if current != source_version:
            add(checks, "shared", warning=f"shared: framework drift at .framework-version ({current or 'unversioned'} -> {source_version})")

    for path in home.rglob("*"):
        if not path.is_file() or ".git" in path.parts or path.name == ".mcp.json":
            continue
        if path.suffix.lower() not in {".md", ".json", ".sh", ".yaml", ".yml"}:
            continue
        if SECRET_PATTERN.search(path.read_text(encoding="utf-8", errors="ignore")):
            add(checks, "shared", error=f"{path.relative_to(home)}: secret-like value detected")


def check_claude(home: Path, checks: dict[str, dict[str, list[str]]], *, require_local_settings: bool = True) -> None:
    required_files = CLAUDE_FILES if require_local_settings else tuple(item for item in CLAUDE_FILES if item != ".claude/settings.local.json")
    for relative in required_files:
        if (home / relative).is_file():
            add(checks, "claude", passed=f"{relative} exists")
        else:
            add(checks, "claude", error=f"claude: {relative} is missing")

    settings_path = home / ".claude/settings.json"
    if settings_path.is_file():
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            add(checks, "claude", error=f".claude/settings.json: invalid JSON ({exc})")
            settings = None
        if isinstance(settings, dict):
            sandbox = settings.get("sandbox")
            filesystem = sandbox.get("filesystem", {}) if isinstance(sandbox, dict) else {}
            if not isinstance(sandbox, dict) or sandbox.get("enabled") is not True:
                add(checks, "claude", error=".claude/settings.json: sandbox.enabled must be true")
            if not isinstance(sandbox, dict) or sandbox.get("autoAllowBashIfSandboxed") is not True:
                add(checks, "claude", error=".claude/settings.json: sandbox.autoAllowBashIfSandboxed must be true")
            denied = set(filesystem.get("denyRead", [])) if isinstance(filesystem, dict) else set()
            missing = {"~/.aws", "~/.ssh", "~/.gnupg", "../"} - denied
            if missing:
                add(checks, "claude", error=".claude/settings.json: missing denyRead entries " + ", ".join(sorted(missing)))
            plugins = settings.get("enabledPlugins")
            if not isinstance(plugins, dict) or plugins.get("persona-manager@personas") is not True:
                add(checks, "claude", error=".claude/settings.json: persona-manager@personas must be enabled")

    local_path = home / ".claude/settings.local.json"
    if require_local_settings and local_path.is_file():
        try:
            local = json.loads(local_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            add(checks, "claude", error=f".claude/settings.local.json: invalid JSON ({exc})")
            local = None
        if isinstance(local, dict):
            memory = local.get("autoMemoryDirectory")
            if not isinstance(memory, str) or not Path(memory).is_absolute():
                add(checks, "claude", error=".claude/settings.local.json: autoMemoryDirectory must be absolute")
            elif Path(memory).resolve() != (home / "user/memory").resolve():
                add(checks, "claude", error=".claude/settings.local.json: autoMemoryDirectory must resolve to this persona's user/memory")

    flags = home / ".claude-flags"
    if flags.is_file() and "--setting-sources project,local" not in flags.read_text(encoding="utf-8"):
        add(checks, "claude", error=".claude-flags: missing --setting-sources project,local")

    hooks = home / "hooks.json"
    if hooks.is_file():
        try:
            hook_data = json.loads(hooks.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            add(checks, "claude", error=f"hooks.json: invalid JSON ({exc})")
            hook_data = None
        if isinstance(hook_data, dict):
            events = hook_data.get("hooks")
            expected = {"PreToolUse", "SessionStart", "Stop", "StopFailure", "PreCompact", "PostCompact"}
            if not isinstance(events, dict):
                add(checks, "claude", error="hooks.json: hooks must be an object")
            elif missing := expected - set(events):
                add(checks, "claude", error="hooks.json: missing events " + ", ".join(sorted(missing)))


def check_codex(home: Path, checks: dict[str, dict[str, list[str]]]) -> None:
    if (home / "AGENTS.md").is_file():
        add(checks, "codex", passed="AGENTS.md exists")
    else:
        add(checks, "codex", error="codex: AGENTS.md is missing")


def github_repository(home: Path) -> str | None:
    remote = subprocess.run(
        ("git", "-C", str(home), "remote", "get-url", "origin"), text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False
    )
    if remote.returncode != 0:
        return None
    value = remote.stdout.strip()
    patterns = (r"git@github\.com:([^/\s]+)/([^/\s]+?)(?:\.git)?$", r"https://github\.com/([^/\s]+)/([^/\s]+?)(?:\.git)?$")
    for pattern in patterns:
        match = re.fullmatch(pattern, value)
        if match:
            return f"{match.group(1)}/{match.group(2)}"
    return None


def private_visibility_error(repository: str | None) -> str | None:
    """Return fail-closed Cloud visibility evidence errors, if any."""
    if not repository or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        return "claude-cloud: GitHub repository identity must be OWNER/REPO"
    adapter = os.environ.get("PERSONAS_GITHUB_VISIBILITY_ADAPTER")
    if adapter:
        try:
            result = subprocess.run((adapter, repository), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        except OSError:
            return "claude-cloud: GitHub visibility adapter is unreachable"
        if result.returncode != 0:
            return "claude-cloud: GitHub visibility adapter is unreachable"
        try:
            evidence = json.loads(result.stdout)
        except json.JSONDecodeError:
            return "claude-cloud: GitHub visibility evidence is unknown"
        if not isinstance(evidence, dict) or evidence.get("authenticated") is not True:
            return "claude-cloud: GitHub authentication is not proven"
        visibility = evidence.get("visibility")
    else:
        try:
            result = subprocess.run(("gh", "repo", "view", repository, "--json", "visibility", "--jq", ".visibility"), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        except OSError:
            return "claude-cloud: authenticated GitHub inspection is unavailable"
        if result.returncode != 0:
            return "claude-cloud: authenticated GitHub inspection is unavailable"
        visibility = result.stdout.strip()
    if visibility != "PRIVATE":
        return f"claude-cloud: repository visibility must be PRIVATE (got {visibility!r})"
    return None


def check_cloud(home: Path, checks: dict[str, dict[str, list[str]]]) -> None:
    repository = github_repository(home)
    if not repository:
        add(checks, "claude-cloud", error="claude-cloud: GitHub repository is ambiguous")
        return
    marker = home / ".persona-cloud-repository"
    if not marker.is_file():
        add(checks, "claude-cloud", error="claude-cloud: .persona-cloud-repository binding marker is missing")
        return
    if marker.read_text(encoding="utf-8").strip() != repository:
        add(checks, "claude-cloud", error=f"claude-cloud: repository binding marker does not match origin ({repository})")
        return
    visibility_error = private_visibility_error(repository)
    if visibility_error:
        add(checks, "claude-cloud", error=visibility_error)
        return
    add(checks, "claude-cloud", passed=f"GitHub repository {repository} binding and visibility are PRIVATE")


def creation_report(status: str, name: str, destination: Path, profile: str, *, errors: list[str] | None = None, staging: Path | None = None, cleaned: bool | None = None) -> dict[str, Any]:
    report: dict[str, Any] = {
        "schemaVersion": 1,
        "status": status,
        "name": name,
        "profile": profile,
        "path": str(destination / name),
        "errors": errors or [],
        "warnings": [],
    }
    if staging is not None:
        report["stagingPath"] = str(staging)
    if cleaned is not None:
        report["stagingCleaned"] = cleaned
    return report


def create(name: str, parent: Path, profile: str, repository: str | None) -> tuple[dict[str, Any], int]:
    destination = parent.resolve()
    if profile not in CREATE_PROFILES:
        return creation_report("FAIL", name, destination, profile, errors=[f"profile: unsupported creation profile {profile!r}"]), 2
    if not NAME_PATTERN.fullmatch(name):
        return creation_report("FAIL", name, destination, profile, errors=["name: use lowercase letters, digits, and hyphens; start with a letter"]), 2
    if not destination.is_dir():
        return creation_report("FAIL", name, destination, profile, errors=[f"destination: {destination} is not an existing directory"]), 1
    final = destination / name
    staging = destination / f".{name}.personas-staging"
    if final.exists():
        return creation_report("FAIL", name, destination, profile, errors=[f"destination: final persona home already exists: {final}"]), 1
    if staging.exists():
        return creation_report("FAIL", name, destination, profile, errors=[f"staging: existing recovery directory requires inspection or cleanup: {staging}"], staging=staging, cleaned=False), 1
    raw_fail_after = os.environ.get("PERSONAS_CREATE_FAIL_AFTER", "0")
    try:
        fail_after = int(raw_fail_after)
    except ValueError:
        return creation_report("FAIL", name, destination, profile, errors=["configuration: PERSONAS_CREATE_FAIL_AFTER must be a non-negative integer"]), 2
    if fail_after < 0:
        return creation_report("FAIL", name, destination, profile, errors=["configuration: PERSONAS_CREATE_FAIL_AFTER must be a non-negative integer"]), 2
    if profile == "claude-cloud":
        visibility_error = private_visibility_error(repository)
        if visibility_error:
            return creation_report("FAIL", name, destination, profile, errors=[visibility_error]), 1

    source = plugin_root()
    assets = source / "skills/persona-dev/assets"
    writes = 0

    def write(path: Path, content: str, *, executable: bool = False) -> None:
        nonlocal writes
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        if executable:
            path.chmod(0o755)
        writes += 1
        if fail_after and writes >= fail_after:
            raise RuntimeError(f"forced creation failure after {writes} writes")

    def template(filename: str) -> str:
        text = (assets / filename).read_text(encoding="utf-8")
        replacements = {
            "{PersonaName}": name.replace("-", " ").title(),
            "{name}": name,
            "{emoji}": "🧭",
            "{role description without personal facts}": "sanitized collaborator",
        }
        for old, new in replacements.items():
            text = text.replace(old, new)
        return text

    try:
        staging.mkdir()
        write(staging / "CLAUDE.md", template("claude-md-template.md"))
        write(staging / "AGENTS.md", template("agents-template.md"))
        write(staging / "README.md", template("readme-template.md"))
        write(staging / ".gitignore", template("gitignore-template"))
        write(staging / ".framework-version", version(source) + "\n")
        write(staging / ".claude-flags", "--setting-sources project,local\n")
        write(staging / ".claude/settings.json", template("settings-template.json"))
        write(staging / "hooks.json", template("hooks-template.json"))
        write(staging / ".claude/hooks/public-repo-guard.sh", (source / "scripts/public-repo-guard.sh").read_text(encoding="utf-8"), executable=True)
        write(staging / "skills" / f"{name}-brief" / "SKILL.md", f"---\nname: {name}-brief\ndescription: Prepare a concise {name} role brief.\n---\n\n# {name.replace('-', ' ').title()} brief\n")
        if profile != "claude-cloud":
            write(staging / "user/profile.md", template("profile-template.md"))
            memory_template = assets / "memory-template.md"
            write(staging / "user/memory/MEMORY.md", memory_template.read_text(encoding="utf-8") if memory_template.is_file() else "# Memory\n")
            write(staging / ".claude/settings.local.json", json.dumps({"autoMemoryDirectory": str(final / "user/memory")}, indent=2) + "\n")
        if profile == "claude-cloud":
            write(staging / ".persona-cloud-repository", repository + "\n")
            write(staging / ".github/workflows/persona-private.yml", template("persona-ci-template.yml"))
            initialized = subprocess.run(("git", "init", "-q", str(staging)), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
            if initialized.returncode != 0:
                raise RuntimeError("cloud repository initialization failed")
            origin = subprocess.run(("git", "-C", str(staging), "remote", "add", "origin", f"https://github.com/{repository}.git"), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
            if origin.returncode != 0:
                raise RuntimeError("cloud repository origin setup failed")
        staging.replace(final)
    except (OSError, RuntimeError, KeyboardInterrupt) as exc:
        cleaned = False
        try:
            if staging.exists():
                shutil.rmtree(staging)
            cleaned = True
        except OSError:
            pass
        return creation_report("FAIL", name, destination, profile, errors=[f"creation: {exc}"], staging=staging, cleaned=cleaned), 1
    report = creation_report("PASS", name, destination, profile)
    report["created"] = ["CLAUDE.md", "AGENTS.md", "README.md", "skills/", "hooks.json"]
    report["repositoryCreation"] = "not attempted; create or select a GitHub repository only with separate authorization" if profile == "claude-cloud" else "not requested"
    return report, 0


def verify(home: Path, profile: str) -> tuple[dict[str, Any], int]:
    if profile not in PROFILES:
        return ({"schemaVersion": 1, "status": "FAIL", "profile": profile, "path": str(home), "checks": {}, "errors": [f"profile: unsupported profile {profile!r}"], "warnings": [], "passes": []}, 2)
    checks: dict[str, dict[str, list[str]]] = {}
    if not home.is_dir():
        return ({"schemaVersion": 1, "status": "FAIL", "profile": profile, "persona": home.name, "path": str(home), "checks": checks, "errors": ["persona directory does not exist"], "warnings": [], "passes": []}, 1)
    source = plugin_root()
    cloud = profile == "claude-cloud"
    check_shared(home, checks, version(source), require_private_state=not cloud)
    if profile in {"claude-local", "claude-cloud"}:
        check_claude(home, checks, require_local_settings=not cloud)
    if profile == "codex":
        check_codex(home, checks)
    if profile == "claude-cloud":
        check_cloud(home, checks)
    legacy = home / ".claude/skills/self-improve"
    if legacy.exists():
        add(checks, "shared", warning="shared: legacy local duplicate at .claude/skills/self-improve; inspect and remove it only with explicit approval")
    errors = [item for section in checks.values() for item in section["errors"]]
    warnings = [item for section in checks.values() for item in section["warnings"]]
    passes = [item for section in checks.values() for item in section["passes"]]
    status = "FAIL" if errors else ("WARN" if warnings else "PASS")
    report = {"schemaVersion": 1, "status": status, "profile": profile, "persona": home.name, "path": str(home), "frameworkSource": str(source), "checks": checks, "errors": errors, "warnings": warnings, "passes": passes}
    return report, 1 if errors else 0


def main() -> int:
    parser = PersonaArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    verify_parser = subcommands.add_parser("verify", help="verify one persona home without mutating it")
    verify_parser.add_argument("persona", type=Path)
    verify_parser.add_argument("--profile", default="shared")
    verify_parser.add_argument("--json", action="store_true")
    create_parser = subcommands.add_parser("create", help="atomically create one sanitized persona home")
    create_parser.add_argument("name")
    create_parser.add_argument("--destination", required=True, type=Path, metavar="PARENT")
    create_parser.add_argument("--profile", default="claude-local")
    create_parser.add_argument("--repository", metavar="OWNER/REPO")
    create_parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.command == "verify":
        report, code = verify(args.persona.resolve(), args.profile)
    else:
        report, code = create(args.name, args.destination, args.profile, args.repository)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        subject = report.get("persona") or report.get("name") or "persona"
        print(f"{report['status']}: {subject} ({report['path']})")
        for item in report["errors"]:
            print(f"FAIL: {item}")
        for item in report["warnings"]:
            print(f"WARN: {item}")
        if report["status"] == "PASS":
            if "created" in report:
                print(f"PASS: created {len(report['created'])} core items")
            else:
                print(f"PASS: {len(report.get('passes', []))} checks")
    return code


if __name__ == "__main__":
    raise SystemExit(main())
