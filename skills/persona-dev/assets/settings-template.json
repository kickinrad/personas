{
  "_personaManagerPrivacy": "Shared project settings only. Keep private overrides and credentials outside Git.",
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md"
  ],
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."],
      "denyRead": ["~/.aws", "~/.ssh", "~/.gnupg", "../"]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "personas": {
      "source": {
        "source": "github",
        "repo": "kickinrad/personas-framework"
      }
    }
  },
  "enabledPlugins": {
    "persona-manager@personas": true
  }
}
